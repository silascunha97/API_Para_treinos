generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              Int            @id @default(autoincrement())
  nome            String         @db.VarChar(100)
  email           String         @unique @db.VarChar(100)
  senha           String?        @db.VarChar(255)
  avatarUrl       String?        @map("avatar_url")
  emailVerificado Boolean        @default(false) @map("email_verificado")
  idPessoa        Int?           @unique @map("id_pessoa")
  criadoEm        DateTime       @default(now()) @map("criado_em")
  atualizadoEm    DateTime       @updatedAt @map("atualizado_em")
  contas          Conta[]
  refreshTokens   RefreshToken[]
  pessoa          Pessoa?        @relation(fields: [idPessoa], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_pessoa")

  @@map("usuario")
}

model Conta {
  id                Int                  @id @default(autoincrement())
  idUsuario         Int                  @map("id_usuario")
  provedor          ProvedorAutenticacao
  provedorAccountId String               @map("provedor_account_id")
  accessToken       String?              @map("access_token")
  refreshToken      String?              @map("refresh_token")
  expiresAt         Int?                 @map("expires_at")
  criadoEm          DateTime             @default(now()) @map("criado_em")
  usuario           Usuario              @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@unique([provedor, provedorAccountId])
  @@map("conta")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  idUsuario Int      @map("id_usuario")
  expiraEm  DateTime @map("expira_em")
  revogado  Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")
  usuario   Usuario  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@map("refresh_token")
}

model Pessoa {
  id                  Int            @id @default(autoincrement())
  peso                Decimal?       @db.Decimal(5, 2)
  altura              Decimal?       @db.Decimal(3, 2)
  taxaMetabolicaBasal Decimal?       @map("taxa_metabolica_basal") @db.Decimal(6, 2)
  sessoesTreino       SessaoTreino[]
  usuario             Usuario?

  @@map("pessoa")
}

model Exercicio {
  idExercicio   Int      @id @default(autoincrement()) @map("id_exercicio")
  nomeExercicio String   @map("nome_exercicio") @db.VarChar(100)
  grupoMuscular String?  @map("grupo_muscular") @db.VarChar(50)
  permiteCarga  Boolean  @default(true) @map("permite_carga")
  tipoExercicio TipoExercicio @default(DINAMICO) @map("tipo_exercicio")
  series        Series[]

  @@map("exercicio")
}

model SessaoTreino {
  idSessao       Int       @id @default(autoincrement()) @map("id_sessao")
  idPessoa       Int       @map("id_pessoa")
  dataHoraInicio DateTime  @map("data_hora_inicio") @db.Timestamp(6)
  dataHoraFim    DateTime? @map("data_hora_fim") @db.Timestamp(6)
  observacoes    String?
  series         Series[]
  pessoa         Pessoa    @relation(fields: [idPessoa], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sessao_pessoa")

  @@map("sessao_treino")
}

model Series {
  idSerie        Int          @id @default(autoincrement()) @map("id_serie")
  idSessao       Int          @map("id_sessao")
  idExercicio    Int          @map("id_exercicio")
  numeroSerie    Int          @map("numero_serie")
  repsRealizadas Int?         @map("reps_realizadas")
  cargaAdicional Decimal?     @map("carga_adicional") @db.Decimal(5, 2)
  concluido      Boolean?     @default(false)
  exercicio      Exercicio    @relation(fields: [idExercicio], references: [idExercicio], onUpdate: NoAction, map: "fk_series_exercicio")
  sessao         SessaoTreino @relation(fields: [idSessao], references: [idSessao], onDelete: Cascade, onUpdate: NoAction, map: "fk_series_sessao")
  tempoIsometriaSeg Int?         @map("tempo_isometria_seg")

  @@map("series")
}

enum TipoExercicio {
  DINAMICO
  ISOMETRICO
  HIBRIDO
}

enum ProvedorAutenticacao {
  LOCAL
  GOOGLE
  GITHUB
}
